---
const q = Astro.url.searchParams.get("q")?.trim() || "";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
      {q ? `Pencarian Kode Pos: ${q}` : "Cari Kode Pos"}
    </title>

    <meta
      name="description"
      content={
        q
          ? `Hasil pencarian kode pos untuk ${q}.`
          : "Cari kode pos berdasarkan provinsi, kabupaten, kecamatan, kelurahan atau desa."
      }
    />

    <link
      rel="canonical"
      href={`${Astro.site ?? "https://kodepos.linkqb.com"}/kode-pos/cari/${q ? `?q=${encodeURIComponent(q)}` : ""}`}
    />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #f8fafc;
        color: #0f172a;
      }

      .container {
        width: min(100% - 32px, 900px);
        margin: 0 auto;
      }

      header {
        background: white;
        border-bottom: 1px solid #e2e8f0;
      }

      .header-inner {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .logo {
        color: #0f172a;
        text-decoration: none;
        font-size: 20px;
        font-weight: 700;
        white-space: nowrap;
      }

      main {
        padding: 48px 0 80px;
      }

      .breadcrumb {
        margin-bottom: 28px;
        font-size: 14px;
        color: #64748b;
      }

      .breadcrumb a {
        color: #475569;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      h1 {
        margin: 0 0 10px;
        font-size: clamp(28px, 5vw, 40px);
        line-height: 1.15;
      }

      .intro {
        margin: 0 0 28px;
        color: #64748b;
        line-height: 1.7;
      }

      .search-form {
        display: flex;
        gap: 10px;
        margin-bottom: 32px;
      }

      .search-input {
        flex: 1;
        min-width: 0;
        height: 48px;
        padding: 0 16px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        background: white;
        color: #0f172a;
        font: inherit;
        outline: none;
      }

      .search-input:focus {
        border-color: #64748b;
        box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.12);
      }

      .search-button {
        height: 48px;
        padding: 0 22px;
        border: 0;
        border-radius: 10px;
        background: #0f172a;
        color: white;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }

      .search-button:hover {
        background: #1e293b;
      }

      .empty {
        padding: 28px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: white;
        color: #64748b;
      }

      footer {
        padding: 24px 0;
        border-top: 1px solid #e2e8f0;
        background: white;
        color: #64748b;
        font-size: 14px;
      }

      @media (max-width: 640px) {
        .container {
          width: min(100% - 24px, 900px);
        }

        main {
          padding-top: 32px;
        }

        .search-form {
          flex-direction: column;
        }

        .search-button {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container header-inner">
        <a class="logo" href="/kode-pos/">
          Kode Pos
        </a>
      </div>
    </header>

    <main>
      <div class="container">
        <nav class="breadcrumb">
          <a href="/kode-pos/">Kode Pos</a>
          /
          <span>Pencarian</span>
        </nav>

        <h1>Cari Kode Pos</h1>

        <p class="intro">
          Cari provinsi, kabupaten/kota, kecamatan,
          kelurahan/desa, atau kode pos.
        </p>

        <form class="search-form" method="get">
          <input
            class="search-input"
            type="search"
            name="q"
            value={q}
            placeholder="Contoh: Aceh, Pidie Jaya, Bandar Baru, 24184"
            autocomplete="off"
          />

          <button class="search-button" type="submit">
            Cari
          </button>
        </form>

        {
          q ? (
            <div class="empty">
              Hasil pencarian untuk <strong>{q}</strong> akan
              ditampilkan di sini.
            </div>
          ) : (
            <div class="empty">
              Masukkan nama wilayah atau kode pos untuk memulai
              pencarian.
            </div>
          )
        }
      </div>
    </main>

    <footer>
      <div class="container">
        Kode Pos Indonesia
      </div>
    </footer>
  </body>
</html>
